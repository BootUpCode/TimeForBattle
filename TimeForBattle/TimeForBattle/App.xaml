<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TimeForBattle"
             x:Class="TimeForBattle.App">
    <Application.Resources>
        <ResourceDictionary>

            <x:Boolean x:Key="BooleanFalse">false</x:Boolean>
            <x:Boolean x:Key="BooleanTrue">true</x:Boolean>
            <x:String x:Key="Attribute0">Str Save</x:String>
            <x:String x:Key="Attribute1">Dex Save</x:String>
            <x:String x:Key="Attribute2">Con Save</x:String>
            <x:String x:Key="Attribute3">Int Save</x:String>
            <x:String x:Key="Attribute4">Wis Save</x:String>
            <x:Int32 x:Key="Int0">0</x:Int32>
            <x:Int32 x:Key="Int1">1</x:Int32>
            <x:Int32 x:Key="Int2">2</x:Int32>
            <x:Int32 x:Key="Int3">3</x:Int32>

            <Color x:Key="Primary">DarkRed</Color>
            <Color x:Key="PrimaryDark">DarkRed</Color>
            <Color x:Key="Accent">#00BCD4</Color>

            <Color x:Key="LightBackground">Beige</Color>
            <Color x:Key="DarkBackground">Beige</Color>

            <Color x:Key="LabelText">Black</Color>
            <Color x:Key="LabelTextDark">Black</Color>

            <Color x:Key="ButtonText">White</Color>
            <Color x:Key="ButtonTextDark">White</Color>

            <Color x:Key="CardBackground">#1C1C1E</Color>
            <Color x:Key="CardBackgroundDark">#1C1C1E</Color>

            <Style TargetType="Page"
                   ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
            </Style>

            <Style ApplyToDerivedTypes="True"
                   TargetType="NavigationPage">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
                <Setter Property="BarBackgroundColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="BarTextColor"
                        Value="White" />
            </Style>

            <Style TargetType="Label"
                   x:Key="BaseLabel">
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource LabelText}, Dark={StaticResource LabelTextDark}}" />
            </Style>

            <Style TargetType="Picker"
                   x:Key="BasePicker">
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource LabelText}, Dark={StaticResource LabelTextDark}}" />
                <Setter Property="TitleColor"
                        Value="Gray" />
            </Style>

            <Style TargetType="Entry"
                   x:Key="BaseEntry">
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource LabelText}, Dark={StaticResource LabelTextDark}}" />
            </Style>

            <Style TargetType="Button"
                   x:Key="BaseButton">
                <Setter Property="FontFamily"
                        Value="OpenSansRegular" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource ButtonText}, Dark={StaticResource ButtonTextDark}}" />
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="BorderColor"
                        Value="Black" />
                <Setter Property="CornerRadius"
                        Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor"
                                            Value="Gray" />
                                    <Setter Property="BackgroundColor"
                                            Value="Beige" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver" />
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="MicroLabel"
                   BasedOn="{StaticResource BaseLabel}"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="8" />
            </Style>

            <Style x:Key="SmallLabel"
                   BasedOn="{StaticResource BaseLabel}"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="12" />
            </Style>

            <Style x:Key="MediumLabel"
                   BasedOn="{StaticResource BaseLabel}"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="16" />
            </Style>

            <Style x:Key="LargeLabel"
                   BasedOn="{StaticResource BaseLabel}"
                   TargetType="Label">
                <Setter Property="FontSize"
                        Value="20" />
            </Style>

            <Style x:Key="StatblockText"
                   TargetType="Label">
                <Setter Property="TextColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="HorizontalOptions"
                        Value="Start" />
                <Setter Property="VerticalOptions"
                        Value="Center" />
            </Style>

            <Style x:Key="StatblockSpan"
                   TargetType="Span">
                <Setter Property="TextColor"
                        Value="{StaticResource Primary}"  />
                <Setter Property="FontSize"
                        Value="14" />
            </Style>

            <Style x:Key="StatblockEntry"
                   TargetType="Entry">
                <Setter  Property="TextColor"
                         Value="{StaticResource Primary}"  />
                <Setter  Property="FontSize"
                         Value="14" />
            </Style>

            <Style x:Key="StatblockEditor"
                   TargetType="Editor">
                <Setter  Property="TextColor"
                         Value="{StaticResource Primary}" />
                <Setter  Property="FontSize"
                         Value="14" />
            </Style>

            <Style x:Key="StatblockLine"
                   TargetType="Line">
                <Setter  Property="Stroke"
                         Value="{StaticResource Primary}"  />
                <Setter  Property="StrokeThickness"
                         Value="2" />
            </Style>

            <Style TargetType="RefreshView"
                   ApplyToDerivedTypes="True">
                <Setter Property="RefreshColor"
                        Value="{StaticResource Primary}" />
            </Style>

            <Style x:Key="ButtonOutline"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
                <Setter Property="TextColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="BorderColor"
                        Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth"
                        Value="2" />
                <Setter Property="HeightRequest"
                        Value="40" />
                <Setter Property="CornerRadius"
                        Value="20" />
            </Style>
            <Style x:Key="CardView"
                   TargetType="Border">
                <Setter Property="Stroke"
                        Value="{StaticResource ButtonText}" />
                <Setter Property="StrokeThickness"
                        Value="1" />
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 10" />
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="Background"
                        Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>