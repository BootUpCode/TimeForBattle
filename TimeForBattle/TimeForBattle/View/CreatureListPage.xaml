<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TimeForBattle.Model"
             xmlns:viewmodel="clr-namespace:TimeForBattle.ViewModel"
             xmlns:converters="clr-namespace:TimeForBattle.Converters"
             x:DataType="viewmodel:CreatureListViewModel"
             Title="{Binding Title}"
             x:Class="TimeForBattle.View.CreatureListPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBool" />
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:ChallengeConverter x:Key="ChallengeConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="*,*,60"
          ColumnSpacing="0"
          RowDefinitions="Auto,*,Auto">

        <Grid Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="0"
              ColumnDefinitions="*,*"
              ColumnSpacing="0"
              RowDefinitions="35,35,35">

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.RowSpan="3"
                    BackgroundColor="Black"
                    Margin="0,0,-1,-1"/>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Text="Main Menu"
                    Command="{Binding GoToMainMenuCommand}"
                    Style="{StaticResource BaseButton}"
                    LineBreakMode="WordWrap" />

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="New"
                    BorderColor="Black"
                    CornerRadius="0"
                    Command="{Binding NewCreatureCommand}"
                    Style="{StaticResource BaseButton}" />

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="View Monsters"
                    BorderColor="Black"
                    CornerRadius="0"
                    Command="{Binding ChangeViewCommand}"
                    Style="{StaticResource BaseButton}">
                <Button.CommandParameter>
                    <x:Boolean>
                        True
                    </x:Boolean>
                </Button.CommandParameter>
            </Button>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Text="View Players"
                    BorderColor="Black"
                    CornerRadius="0"
                    Command="{Binding ChangeViewCommand}"
                    Style="{StaticResource BaseButton}">
                <Button.CommandParameter>
                    <x:Boolean>
                        False
                    </x:Boolean>
                </Button.CommandParameter>
            </Button>

            <Border Grid.Row="2"
                    Grid.Column="1"
                    BackgroundColor="DarkRed"
                    Margin="0,0,0,1"/>
            <Entry  Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,5,5,5"
                    Text="{Binding SearchInput}"
                    Style="{StaticResource BaseEntry}"
                    TextColor="Black"
                    Placeholder="Search..."
                    HorizontalOptions="Fill"
                    HeightRequest="35"/>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    BackgroundColor="DarkRed"
                    Stroke="Black"
                    StrokeThickness="1"
                    Margin="-1,-1,-1,0">
                <HorizontalStackLayout>
                    <Label Text="Sort by:"
                           Style="{StaticResource BaseLabel}"
                           TextColor="White"
                           Margin="10,7,10,5" />
                    <Picker Style="{StaticResource BasePicker}"
                            TextColor="Black"
                            ItemsSource="{Binding SortNames}"
                            SelectedItem="{Binding PickedSort}"
                            VerticalOptions="Start"
                            HorizontalOptions="Start"
                            MinimumWidthRequest="120"
                            WidthRequest="120"
                            HeightRequest="35"
                            Margin="0,0,0,0" />
                </HorizontalStackLayout>
            </Border>

        </Grid>

        <ScrollView Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Padding="0,2,0,2">
            <FlexLayout BackgroundColor="Transparent"
                        BindableLayout.ItemsSource="{Binding Creatures}"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceEvenly"
                        AlignItems="Start"
                        AlignContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:Creature">
                        <Grid Padding="0,2,0,0">
                            <Border HeightRequest="180"
                                    WidthRequest="155"
                                    Stroke="DarkRed"
                                    StrokeThickness="2">
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="5"
                                      RowDefinitions="25,2,*,*,*,2,*,*,2,35"
                                      RowSpacing="2"
                                      Padding="4">

                                    <Label Grid.ColumnSpan="2"
                                           Grid.Row="0"
                                           Text="{Binding Name}"
                                           LineBreakMode="TailTruncation"
                                           FontSize="20"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}"
                                           Margin="0,0,0,-2" />
                                    <Line Grid.ColumnSpan="2"
                                          Grid.Row="1"
                                          X1="-5"
                                          X2="200"
                                          Stroke="DarkRed"
                                          StrokeThickness="2" />
                                    <Label Grid.ColumnSpan="2"
                                           Grid.Row="2"
                                           VerticalOptions="Center"
                                           FontAttributes="Italic"
                                           TextColor="Grey"
                                           Margin="0,-10,0,-10"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="{Binding IsPlayer, Converter={StaticResource InvertedBool}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Size" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Grid.ColumnSpan="2"
                                           Grid.Row="2"
                                           VerticalOptions="Center"
                                           FontAttributes="Italic"
                                           TextColor="Grey"
                                           IsVisible="{Binding IsPlayer}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Type" />
                                                <Binding Path="Alignment" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Grid.Column="0"
                                           Grid.Row="3"
                                           Text="{Binding ArmorClass, StringFormat='AC: {0}'}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}" />
                                    <Label Grid.Column="1"
                                           Grid.Row="3"
                                           IsVisible="{Binding IsPlayer, Converter={StaticResource InvertedBool}}"
                                           Text="{Binding ChallengeRating, Converter={StaticResource ChallengeConverter}, StringFormat='CR: {0}'}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}" />
                                    <Label Grid.Column="1"
                                           Grid.Row="3"
                                           IsVisible="{Binding IsPlayer}"
                                           Text="{Binding ChallengeRating, Converter={StaticResource ChallengeConverter}, StringFormat='Level: {0}'}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}" />
                                    <Label Grid.Column="0"
                                           Grid.Row="4"
                                           Text="{Binding MaximumHitPoints, StringFormat='HP: {0}'}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}" />
                                    <Label Grid.Column="1"
                                           Grid.Row="4"
                                           Text="{Binding InitiativeBonus, StringFormat='Init: +{0}'}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource BaseLabel}" />
                                    <Line Grid.ColumnSpan="2"
                                          Grid.Row="5"
                                          X1="-5"
                                          X2="200"
                                          Stroke="DarkRed"
                                          StrokeThickness="2" />
                                    <Grid Grid.Row="6"
                                          Grid.ColumnSpan="2"
                                          Grid.RowSpan="2"
                                          ColumnDefinitions="*,*,*,*,*,*"
                                          ColumnSpacing="4"
                                          RowDefinitions="*,*">

                                        <Label Grid.Column="0"
                                               Grid.Row="0"
                                               Text="STR"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="1"
                                               Grid.Row="0"
                                               Text="DEX"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="2"
                                               Grid.Row="0"
                                               Text="CON"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="3"
                                               Grid.Row="0"
                                               Text="INT"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="4"
                                               Grid.Row="0"
                                               Text="WIS"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="5"
                                               Grid.Row="0"
                                               Text="CHA"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="0"
                                               Grid.Row="1"
                                               Text="{Binding StrScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="1"
                                               Grid.Row="1"
                                               Text="{Binding DexScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="2"
                                               Grid.Row="1"
                                               Text="{Binding ConScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="3"
                                               Grid.Row="1"
                                               Text="{Binding IntScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="4"
                                               Grid.Row="1"
                                               Text="{Binding WisScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                        <Label Grid.Column="5"
                                               Grid.Row="1"
                                               Text="{Binding ChaScore}"
                                               FontSize="9"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource BaseLabel}" />
                                    </Grid>
                                    <Line Grid.ColumnSpan="2"
                                          Grid.Row="8"
                                          X1="-5"
                                          X2="200"
                                          Stroke="DarkRed"
                                          StrokeThickness="2" />
                                    <Button Grid.Column="0"
                                            Grid.Row="9"
                                            Text="Add"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=AddToInitiativeCommand}"
                                            IsVisible="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=Combat, Converter={StaticResource IsNotNullConverter}}"
                                            Style="{StaticResource BaseButton}" />
                                    <Button Grid.Column="1"
                                            Grid.Row="9"
                                            Text="View"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=GoToDetailsCommand}"
                                            Style="{StaticResource BaseButton}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Grid.Row="2">

            <BoxView HeightRequest="2"
                     Color="DarkRed"
                     IsVisible="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=Combat, Converter={StaticResource IsNotNullConverter}}" />

            <Grid ColumnDefinitions="*"
                  ColumnSpacing="0"
                  RowDefinitions="20,*"
                  RowSpacing="0"
                  IsVisible="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=Combat, Converter={StaticResource IsNotNullConverter}}">

                <Label Grid.Row="0"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Text="Creatures in Initiative:"
                       Style="{StaticResource BaseLabel}" />
                <ScrollView Grid.Row="1"
                            Grid.Column="1"
                            MaximumHeightRequest="150">

                    <CollectionView BackgroundColor="Transparent"
                                    ItemsSource="{Binding Initiative}"
                                    SelectionMode="None"
                                    MinimumHeightRequest="30">

                        <CollectionView.EmptyView>
                            <ContentView>
                                <Label Text="None"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                            </ContentView>

                        </CollectionView.EmptyView>

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:InitiativeCreature">
                                <Grid Padding="0">
                                    <Grid ColumnDefinitions="*,100"
                                          ColumnSpacing="0"
                                          RowDefinitions="1,35"
                                          RowSpacing="0">
                                        <BoxView Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Grid.Row="0"
                                                 HeightRequest="1"
                                                 Color="Black" />
                                        <HorizontalStackLayout Grid.Column="0"
                                                               Grid.Row="1">
                                            <Label VerticalOptions="Center"
                                                   Text="{Binding Creature.Name}"
                                                   LineBreakMode="TailTruncation"
                                                   MaximumWidthRequest="200"
                                                   Padding="10,0,0,0"
                                                   Style="{StaticResource BaseLabel}" />
                                            <Label VerticalOptions="Center"
                                                   HorizontalOptions="Start"
                                                   Text="{Binding InitiativeCreatureData.NameID}"
                                                   Padding="4,0,10,0"
                                                   Style="{StaticResource BaseLabel}" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Column="2"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Text="Remove"
                                                MinimumWidthRequest="100"
                                                MaximumWidthRequest="100"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=RemoveFromInitiativeCommand}"
                                                Style="{StaticResource BaseButton}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </Grid>

            <Button Command="{Binding GoToInitiativeCommand}"
                    Text="View Initiative"
                    BorderColor="Black"
                    HeightRequest="35"
                    CornerRadius="0"
                    Style="{StaticResource BaseButton}"
                    IsVisible="{Binding x:DataType='viewmodel:CreatureListViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:CreatureListViewModel}}, Path=Combat, Converter={StaticResource IsNotNullConverter}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>