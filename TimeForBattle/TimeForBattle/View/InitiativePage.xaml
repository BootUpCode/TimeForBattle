                                                   Grid.Row="1"
                                                   Padding="0,5,0,0"
                                                   Spacing="3">
                                <Label FontAttributes="Bold"
                                       Text="{Binding Damage1}"
                                       Style="{StaticResource BaseLabel}"
                                       IsVisible="{Binding Damage1, Converter={StaticResource StringContainDataConverter}}" />
                                <Label FontAttributes="Bold"
                                       Text="{Binding DamageType1}"
                                       IsVisible="{Binding DamageType1, Converter={StaticResource StringContainDataConverter}}"
                                       LineBreakMode="TailTruncation"
                                       Style="{StaticResource BaseLabel}" />
                                <Label FontAttributes="Bold"
                                       Text="+"
                                       Style="{StaticResource BaseLabel}"
                                       IsVisible="{Binding Damage2, Converter={StaticResource StringContainDataConverter}}" />
                                <Label FontAttributes="Bold"
                                       Text="{Binding Damage2}"
                                       Style="{StaticResource BaseLabel}"
                                       IsVisible="{Binding Damage2, Converter={StaticResource StringContainDataConverter}}" />
                                <Label FontAttributes="Bold"
                                       Text="{Binding DamageType2}"
                                       IsVisible="{Binding DamageType2, Converter={StaticResource StringContainDataConverter}}"
