                                        <Binding Path="ModifierString" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            </HorizontalStackLayout>
                            
                            <HorizontalStackLayout Grid.Column="0"
                                                   Grid.Row="1"
                                                   Grid.RowSpan="2"
                                                   Padding="15,0,0,0"
                                                   Spacing="1">
