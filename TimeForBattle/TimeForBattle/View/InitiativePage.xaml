                                                   IsVisible="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=Combat.IsStarted, Converter={StaticResource InvertedBoolConverter}}"
