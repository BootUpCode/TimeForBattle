<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TimeForBattle.Model"
             xmlns:viewmodel="clr-namespace:TimeForBattle.ViewModel"
             xmlns:converters="clr-namespace:TimeForBattle.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:DataType="viewmodel:InitiativeViewModel"
             Title="{Binding Combat.Name}"
             x:Class="TimeForBattle.View.InitiativePage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Name="root">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:EntryToNullableIntConverter x:Key="EntryToNullableIntConverter" />
        <converters:HitpointConverter x:Key="HitpointConverter" />
        <converters:RollConverter x:Key="RollConverter" />
        <converters:RollColorConverter x:Key="RollColorConverter" />
        <converters:AdditionConverter x:Key="AdditionConverter" />
        <converters:StringContainDataConverter x:Key="StringContainDataConverter" />
        <converters:StringsContainDataConverter x:Key="StringsContainDataConverter" />
        <converters:NotStringContainDataConverter x:Key="NotStringContainDataConverter" />
        <converters:IsZeroConverter x:Key="IsZeroConverter" />
        <converters:CreatureColorConverter x:Key="CreatureColorConverter" />
        <converters:CreatureNameBoldConverter x:Key="CreatureNameBoldConverter" />
        <converters:CreatureNameStrikethroughConverter x:Key="CreatureNameStrikethroughConverter" />
        <converters:CreatureHotKeyWidthConverter x:Key="CreatureHotKeyWidthConverter" />
        <converters:CreatureHotKeyLocationConverter x:Key="CreatureHotKeyLocationConverter" />
        <converters:PauseButtonTextConverter x:Key="PauseButtonTextConverter" />
        <converters:IsEqualConverter x:Key="IsEqualConverter" />
        <converters:IsNotEqualConverter x:Key="IsNotEqualConverter" />
        <converters:ConditionsConverter x:Key="ConditionsConverter" />
        <converters:ImmunityConverter x:Key="ImmunityConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="3*,3*,4*,6*,3*"
          ColumnSpacing="0"
          RowDefinitions="40,25,25,1,*,2,155">

        <Button Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="0"
                Text="Main Menu"
                Command="{Binding GoToMainMenuCommand}"
                Style="{StaticResource BaseButton}"
                LineBreakMode="WordWrap" />
        <Button Grid.Column="3"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                Text="{Binding Combat.IsStarted, Converter={StaticResource PauseButtonTextConverter}}"
                LineBreakMode="WordWrap"
                Command="{Binding GoToCreatureListCommand}"
                IsEnabled="{Binding Combat.IsStarted, Converter={StaticResource InvertedBoolConverter}}"
                Style="{StaticResource BaseButton}"
                Padding="15,-5,15,-2"/>
        
        <Button Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Text="Start"
                Padding="0,0,0,0"
                FontAttributes="Bold"
                Command="{Binding RollInitiativeCommand}"
                IsVisible="{Binding Combat.IsStarted, Converter={StaticResource InvertedBoolConverter}}"
                Style="{StaticResource BaseButton}" />
        <Button Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Text="||"
                FontAttributes="Bold"
                Command="{Binding PauseInitiativeCommand}"
                IsVisible="{Binding Combat.IsStarted}"
                Style="{StaticResource BaseButton}" />
        
        <Button Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="2"
                Text="&lt;"
                FontAttributes="Bold"
                FontSize="Large"
                Command="{Binding PreviousCreatureCommand}"
                IsEnabled="{Binding Combat.IsStarted}"
                Style="{StaticResource BaseButton}" />
        <Button Grid.Column="4"
                Grid.Row="1"
                Grid.RowSpan="2"
                Text="&gt;"
                FontAttributes="Bold"
                FontSize="Large"
                Command="{Binding NextCreatureCommand}"
                IsEnabled="{Binding Combat.IsStarted}"
                Style="{StaticResource BaseButton}" />

        <Label Grid.Column="2"
               Grid.ColumnSpan="2"
               Grid.Row="1"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding Combat.IsStarted}"
               Style="{StaticResource BaseLabel}">
            <Label.Text>
                <MultiBinding StringFormat='{}Round {0}, Init. {1}'>
                    <Binding Path="Combat.RoundCount" />
                    <Binding Path="CurrentCreature.InitiativeCreatureData.Initiative" />
                </MultiBinding>
            </Label.Text>
        </Label>
        <Label Grid.Column="2"
               Grid.ColumnSpan="2"
               Grid.Row="2"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding Combat.IsStarted}"
               LineBreakMode="WordWrap"
               Style="{StaticResource BaseLabel}">
            <Label.Text>
                <MultiBinding StringFormat="{}{0} {1}&apos;s turn">
                    <Binding Path="CurrentCreature.Creature.Name" />
                    <Binding Path="CurrentCreature.InitiativeCreatureData.NameID" />
                </MultiBinding>
            </Label.Text>
        </Label>
        

        <BoxView Grid.Column="0"
                 Grid.ColumnSpan="5"
                 Grid.Row="3"
                 HeightRequest="1"
                 Color="Black" />

        <ScrollView Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Grid.Row="4">
            <FlexLayout BackgroundColor="Transparent"
                        BindableLayout.ItemsSource="{Binding Initiative}"
                        HorizontalOptions="Start"
                        Direction="Column"
                        Wrap="NoWrap"
                        JustifyContent="Start"
                        AlignContent="Start"
                        Padding="0,3,0,3">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="model:InitiativeCreature">
                        <VerticalStackLayout Padding="3,3,3,3">
                            <Border Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.RowSpan="1"
                                    Stroke="{Binding InitiativeCreatureData.IsTurn, Converter={StaticResource CreatureColorConverter}}"
                                    StrokeThickness="2"
                                    WidthRequest="300" >
                                <toolkit:Expander Grid.Column="1"
                                                  Grid.Row="0"
                                                  Grid.RowSpan="1"
                                                  IsExpanded="{Binding Path=InitiativeCreatureData.IsExpanded, Mode=TwoWay}">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="58,58,58,58,58"
                                              ColumnSpacing="0"
                                              RowDefinitions="*"
                                              RowSpacing="0"
                                              Padding="3,3,3,3">

                                            <Button Grid.Column="0"
                                                    Grid.Row="0"
                                                    Text="HP"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=SetActiveTabFirstCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="1"
                                                    Style="{StaticResource BaseButton}" >
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource IsNotEqualConverter}">
                                                        <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                        <Binding Path="Tabvalue"
                                                                 FallbackValue="0" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Grid.Row="0"
                                                    Text="Actions"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=SetActiveTabSecondCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="1"
                                                    Style="{StaticResource BaseButton}" >
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource IsNotEqualConverter}">
                                                        <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                        <Binding Path="Tabvalue"
                                                                 FallbackValue="1" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Grid.Row="0"
                                                    Text="Saves"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=SetActiveTabThirdCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="1"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource IsNotEqualConverter}">
                                                        <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                        <Binding Path="Tabvalue"
                                                                 FallbackValue="2" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Grid.Row="0"
                                                    Text="Status"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=SetActiveTabFourthCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="1"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource IsNotEqualConverter}">
                                                        <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                        <Binding Path="Tabvalue"
                                                                 FallbackValue="3" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Grid.Row="0"
                                                    Text="Details"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=GoToDetailsCommand}"
                                                    Padding="1"
                                                    Style="{StaticResource BaseButton}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="48,48,49,49,48,48"
                                              ColumnSpacing="0"
                                              RowDefinitions="35"
                                              RowSpacing="0"
                                              Padding="3,3,3,3">
                                            <Grid.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                    <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                    <Binding Path="Tabvalue"
                                                             FallbackValue="0" />
                                                </MultiBinding>
                                            </Grid.IsVisible>

                                            <Button Grid.Column="0"
                                                    Grid.Row="0"
                                                    Text="-10"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=CurrentHitPointsMinusTenCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="0"
                                                    Style="{StaticResource BaseButton}" />
                                            <Button Grid.Column="1"
                                                    Grid.Row="0"
                                                    Text="-1"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=CurrentHitPointsMinusOneCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="0"
                                                    Style="{StaticResource BaseButton}" />
                                            <Entry Grid.Column="2"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Text="{Binding InitiativeCreatureData.CurrentHitPoints}"
                                                   WidthRequest="50"
                                                   MinimumWidthRequest="50"
                                                   HeightRequest="35"
                                                   VerticalOptions="Center"
                                                   MaxLength="4"
                                                   Keyboard="Numeric"
                                                   Style="{StaticResource BaseEntry}" />
                                            <Label Grid.Column="3"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Text="{Binding Creature.MaximumHitPoints, StringFormat='{} / {0}'}"
                                                   VerticalOptions="Center"
                                                   Style="{StaticResource BaseLabel}" />
                                            <Button Grid.Column="4"
                                                    Grid.Row="0"
                                                    Text="+1"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=CurrentHitPointsPlusOneCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="0"
                                                    Style="{StaticResource BaseButton}" />
                                            <Button Grid.Column="5"
                                                    Grid.Row="0"
                                                    Text="+10"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=CurrentHitPointsPlusTenCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Padding="0"
                                                    Style="{StaticResource BaseButton}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="48,48,49,49,48,48"
                                              ColumnSpacing="0"
                                              RowDefinitions="35"
                                              RowSpacing="0"
                                              Padding="3,3,3,3">
                                            <Grid.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                    <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                    <Binding Path="Tabvalue"
                                                             FallbackValue="1" />
                                                </MultiBinding>
                                            </Grid.IsVisible>

                                            <Button x:Name="HotKeyButton1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="{Binding ., Converter={StaticResource CreatureHotKeyWidthConverter}}"
                                                    Grid.Row="0"
                                                    Text="{Binding Creature.HotKey1Name}"
                                                    Padding="5"
                                                    IsVisible="{Binding Creature.HotKey1Name, Converter={StaticResource StringContainDataConverter}}"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.HotKey1Bonus" />
                                                        <Binding Path="Creature.HotKey1Name" />
                                                        <Binding Path="Creature.HotKey1DamageDiceNumber1" />
                                                        <Binding Path="Creature.HotKey1DamageDiceSize1" />
                                                        <Binding Path="Creature.HotKey1DamageBonus1" />
                                                        <Binding Path="Creature.HotKey1DamageType1" />
                                                        <Binding Path="Creature.HotKey1DamageDiceNumber2" />
                                                        <Binding Path="Creature.HotKey1DamageDiceSize2" />
                                                        <Binding Path="Creature.HotKey1DamageBonus2" />
                                                        <Binding Path="Creature.HotKey1DamageType2" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>

                                            <Button x:Name="HotKeyButton2"
                                                    Grid.Column="{Binding ., Converter={StaticResource CreatureHotKeyLocationConverter}}"
                                                    Grid.ColumnSpan="{Binding ., Converter={StaticResource CreatureHotKeyWidthConverter}}"
                                                    Grid.Row="0"
                                                    Text="{Binding Creature.HotKey2Name}"
                                                    Padding="5"
                                                    IsVisible="{Binding Creature.HotKey2Name, Converter={StaticResource StringContainDataConverter}}"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.HotKey2Bonus" />
                                                        <Binding Path="Creature.HotKey2Name" />
                                                        <Binding Path="Creature.HotKey2DamageDiceNumber1" />
                                                        <Binding Path="Creature.HotKey2DamageDiceSize1" />
                                                        <Binding Path="Creature.HotKey2DamageBonus1" />
                                                        <Binding Path="Creature.HotKey2DamageType1" />
                                                        <Binding Path="Creature.HotKey2DamageDiceNumber2" />
                                                        <Binding Path="Creature.HotKey2DamageDiceSize2" />
                                                        <Binding Path="Creature.HotKey2DamageBonus2" />
                                                        <Binding Path="Creature.HotKey2DamageType2" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="48,48,49,49,48,48"
                                              ColumnSpacing="0"
                                              RowDefinitions="35"
                                              RowSpacing="0"
                                              Padding="3,3,3,3">
                                            <Grid.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                    <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                    <Binding Path="Tabvalue"
                                                             FallbackValue="2" />
                                                </MultiBinding>
                                            </Grid.IsVisible>

                                            <Button Grid.Column="0"
                                                    Grid.Row="0"
                                                    Text="STR"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.StrSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Str Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Grid.Row="0"
                                                    Text="DEX"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.DexSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Dex Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Grid.Row="0"
                                                    Text="CON"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.ConSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Con Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Grid.Row="0"
                                                    Text="INT"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.IntSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Int Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Grid.Row="0"
                                                    Text="WIS"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.WisSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Wis Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="5"
                                                    Grid.Row="0"
                                                    Text="CHA"
                                                    Padding="5"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RollSaveCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RollConverter}">
                                                        <Binding Path="." />
                                                        <Binding Path="Creature.ChaSaveBonus" />
                                                        <Binding Path="RollName"
                                                                 FallbackValue="Cha Save" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="105,*,40,80"
                                              ColumnSpacing="0"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                              RowSpacing="0"
                                              Padding="3,3,3,3">
                                            <Grid.IsVisible>
                                                <MultiBinding Converter="{StaticResource IsEqualConverter}">
                                                    <Binding Path=".InitiativeCreatureData.ActiveTab" />
                                                    <Binding Path="Tabvalue"
                                                             FallbackValue="3" />
                                                </MultiBinding>
                                            </Grid.IsVisible>
                                            <Label Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Grid.Row="0"
                                                   Text="Select Condition"
                                                   IsVisible="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=PickedCondition, Converter={StaticResource NotStringContainDataConverter}}"
                                                   VerticalOptions="Start"
                                                   HorizontalOptions="Start"
                                                   MinimumWidthRequest="200"
                                                   WidthRequest="200"
                                                   HeightRequest="38"
                                                   Margin="12,10,0,-10"
                                                   TextColor="Black"/>
                                            <Picker Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Row="0"
                                                        Style="{StaticResource BasePicker}"
                                                        ItemsSource="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=ConditionNames}"
                                                        SelectedItem="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=PickedCondition}"
                                                        VerticalOptions="Start"
                                                        HorizontalOptions="Start"
                                                        MinimumWidthRequest="200"
                                                        WidthRequest="200"
                                                        HeightRequest="38"
                                                        Margin="0,0,0,0" />
                                            <Button Grid.Column="3"
                                                    Grid.Row="0"
                                                    Text="Add"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=SetConditionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource BaseButton}" />

                                            <Label Grid.Column="0"
                                                   Grid.Row="1"
                                                   Text="Condition"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"
                                                   Margin="3,0,0,0"
                                                   FontAttributes="Bold"
                                                   Style="{StaticResource BaseLabel}">
                                                <Label.IsVisible>
                                                    <MultiBinding Converter="{StaticResource StringsContainDataConverter}">
                                                        <Binding Path="InitiativeCreatureData.ConditionString1" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString2" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString3" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString4" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString5" />
                                                    </MultiBinding>
                                                </Label.IsVisible>
                                            </Label>
                                            <Label Grid.Column="1"
                                                   Grid.Row="1"
                                                   Text="Started"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"
                                                   Margin="3,0,0,0"
                                                   FontAttributes="Bold"
                                                   Style="{StaticResource BaseLabel}">
                                                <Label.IsVisible>
                                                    <MultiBinding Converter="{StaticResource StringsContainDataConverter}">
                                                        <Binding Path="InitiativeCreatureData.ConditionString1" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString2" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString3" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString4" />
                                                        <Binding Path="InitiativeCreatureData.ConditionString5" />
                                                    </MultiBinding>
                                                </Label.IsVisible>
                                            </Label>

                                            <Label Grid.Column="0"
                                                   Grid.Row="2"
                                                   Text="{Binding InitiativeCreatureData.ConditionString1}"
                                                   IsVisible="{Binding InitiativeCreatureData.ConditionString1, Converter={StaticResource StringContainDataConverter}}"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Start"
                                                   Margin="3,1,0,0"
                                                   Style="{StaticResource BaseLabel}" />
                                            <Label Grid.Column="0"
                                                   Grid.Row="2"
                                                   IsVisible="{Binding InitiativeCreatureData.ConditionString1, Converter={StaticResource StringContainDataConverter}}"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="End"
                                                   Margin="3,0,0,0"
                                                   TextColor="DarkRed">
                                                <Label.Text>
                                                    <MultiBinding Converter="{StaticResource ImmunityConverter}">
                                                        <Binding Path="InitiativeCreatureData.ConditionString1" />
                                                        <Binding Path="Creature.Immunities" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Label Grid.Column="1"
                                                   Grid.Row="2"
                                                   Text="{Binding InitiativeCreatureData.ConditionTimeString1}"
                                                   IsVisible="{Binding InitiativeCreatureData.ConditionString1, Converter={StaticResource StringContainDataConverter}}"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"
                                                   Margin="3,0,0,0"
                                                   Style="{StaticResource BaseLabel}"  />
                                            <Button Grid.Column="2"
                                                    Grid.Row="2"
                                                    Text="?"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=ShowConditionInfoCommand}"
                                                    CommandParameter="{Binding InitiativeCreatureData.ConditionString1}"
                                                    Style="{StaticResource BaseButton}"
                                                    IsVisible="{Binding InitiativeCreatureData.ConditionString1, Converter={StaticResource StringContainDataConverter}}" />
                                            <Button Grid.Column="3"
                                                    Grid.Row="2"
                                                    Text="Remove"
                                                    Command="{Binding x:DataType='viewmodel:InitiativeViewModel', Source={RelativeSource AncestorType={x:Type viewmodel:InitiativeViewModel}}, Path=RemoveCondition1Command}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource BaseButton}"
                                                    IsVisible="{Binding InitiativeCreatureData.ConditionString1, Converter={StaticResource StringContainDataConverter}}"
                                                    Padding="-5,0,-5,0" />
